{
	"nodes":[
		{"id":"ff6eb38a485da5b2","type":"text","text":"Что я хочу делать?","x":-493,"y":-244,"width":250,"height":60,"color":"6"},
		{"id":"5cdd52334fe5a713","type":"text","text":"Игры","x":-75,"y":-244,"width":250,"height":60},
		{"id":"d06eef4a2e1b04bb","type":"text","text":"Зачем я хочу делать игры?","x":300,"y":-244,"width":250,"height":60,"color":"3"},
		{"id":"2620808c62aad1e8","type":"text","text":"Процесс разработки мне интересен, это сильно творческий процесс, который мне нужен.","x":696,"y":-272,"width":319,"height":116},
		{"id":"3962403f9853c5a2","type":"text","text":"Движок","x":-75,"y":-932,"width":250,"height":60},
		{"id":"69b7a5337696eba7","type":"text","text":"Зачем мне разрабатывать свой движок?","x":300,"y":-932,"width":250,"height":60,"color":"3"},
		{"id":"97170deecc1a00ea","type":"text","text":"Это позволяет мне глубже разбираться в технологиях и системах на которых все строится\n\nБез понимания тяжело делать игры более качественно и разнообразно. Например чтобы написать шейдер, которые что-то делает очень крутое - нужно понимать как это все работает, как устроен рендеринг.\n\nБез понимания на более низком уровне - тяжело создавать что-то по настоящему новое.\n\nЧувствую себя курицей в курятнике, которая думает что это весь мир.","x":720,"y":-1102,"width":385,"height":400},
		{"id":"9b759a3ae403a242","type":"text","text":"Закреплять знания. Когда пишешь статью, ты дополнительно изучаешь материал о котором пишешь, это позволяет глубже разобраться","x":856,"y":830,"width":331,"height":122},
		{"id":"6b84e8890ba96adc","type":"text","text":"Хочу научиться доносить информацию на техническом уровне более эффективно. Сейчас из-за того что у меня очень низкий терминалогический слкад ума - тяжело анализировать технические вопросы и темблоее о них доносить для попытки лучшего решения","x":856,"y":1040,"width":369,"height":208},
		{"id":"0f5f224080d0a535","type":"text","text":"Вести блог","x":-69,"y":861,"width":250,"height":60},
		{"id":"006d1b2a71a13146","type":"text","text":"Зачем мне нужен блог?","x":366,"y":861,"width":250,"height":60,"color":"3"},
		{"id":"92710a86ebc7443b","type":"text","text":"Как я хочу это делать?","x":366,"y":1460,"width":250,"height":60,"color":"3"},
		{"id":"dff4fd7fa8b57ba3","type":"text","text":"Объемные и продуманные статьи по темам","x":856,"y":1364,"width":250,"height":60},
		{"id":"b3646f7b819a35b0","type":"text","text":"Стриминг","x":856,"y":1460,"width":250,"height":60},
		{"id":"b0187351a6af0a06","type":"text","text":"Лайтовые посты для высказывания своего мнения","x":856,"y":1557,"width":318,"height":83},
		{"id":"3c0040891b0d7103","type":"text","text":"Какие я хочу делать игры?","x":300,"y":-95,"width":250,"height":60,"color":"3"},
		{"id":"0ef030b7019d5752","type":"text","text":"Что я хочу делать при помощи своего движка?","x":300,"y":-762,"width":250,"height":60,"color":"3"},
		{"id":"d02d3accc669582b","type":"text","text":"О чем я хочу рассказывать?","x":366,"y":1800,"width":250,"height":60,"color":"3"},
		{"id":"78895a7915d224c0","type":"text","text":"Для чего мне это нужно?","x":1225,"y":1460,"width":250,"height":60,"color":"3"},
		{"id":"df06b46c58639f32","type":"text","text":"Какой в этом смысл?","x":1260,"y":1569,"width":250,"height":60,"color":"3"},
		{"id":"998a90e39be3224e","type":"text","text":"Хочу собирать комьюнити, которое можно было бы использовать для продвижения проектов","x":856,"y":640,"width":304,"height":116},
		{"id":"7530fd345e18d5a2","type":"text","text":"Для кого будет этот блог?","x":366,"y":1998,"width":250,"height":60,"color":"3"},
		{"id":"c9e64e09a489da85","type":"text","text":"К чему бы я хотел прийти в разработке игр?","x":300,"y":60,"width":250,"height":60,"color":"3"},
		{"id":"d1ea3d40a29ecfd7","type":"text","text":"Возможность дополнительного заработка за информацию которой буду делиться","x":856,"y":460,"width":286,"height":112},
		{"id":"0a389ee89590ba65","type":"text","text":"Снимать видео на ютуб","x":865,"y":1686,"width":250,"height":60},
		{"id":"ac790d3ecd64d8eb","type":"text","text":"Что это будут за видео?","x":1260,"y":1686,"width":250,"height":60,"color":"3"},
		{"id":"c559389dd86f22f6","type":"text","text":"Туториалы ","x":1658,"y":1680,"width":200,"height":72},
		{"id":"986cb94a15d3b34c","type":"text","text":"Какие туториалы?","x":1960,"y":1686,"width":250,"height":60,"color":"3"},
		{"id":"5888a869d97c0b1a","type":"text","text":"Рассказывать о том как я разрабатываю движок","x":2195,"y":2160,"width":250,"height":60},
		{"id":"1e7a55fc51279440","type":"text","text":"О чем?","x":1960,"y":2184,"width":115,"height":60,"color":"3"},
		{"id":"5c9b2ab09a9c0dc4","type":"text","text":"Рассказывать о том как я делаю игры","x":2195,"y":2250,"width":250,"height":60},
		{"id":"bcedb44cc0f0d8ba","type":"text","text":"Девлог","x":1675,"y":2184,"width":125,"height":60},
		{"id":"57d362d6aedd3737","type":"text","text":"Разработка на движке Unity. Его особенности. Хочу поделиться всем опытом, что получилось набрать за 7 лет. Рассказать о каких-то своих идеях или реализациях к которым я смог прийти","x":2360,"y":1441,"width":396,"height":158},
		{"id":"e0888767b2fb57df","x":2367,"y":1664,"width":389,"height":102,"type":"text","text":"Делать туторилы по низкоуровневым штука. Например как устроен рендеринг или физика и прочее. Возможно на конкретных примерах"},
		{"id":"1aad358699abd436","x":2367,"y":1797,"width":479,"height":167,"type":"text","text":"Возможно что-то о вебе, например как сделать бота или как это устроено. В целом мне достаточно сильно интересен веб как технология и все что существует в этой сфере, я ее чувствую по своему. Место в котором доступно много возможностей и устроено иначе."},
		{"id":"64f4599688aa054c","x":-480,"y":4160,"width":250,"height":60,"color":"6","type":"text","text":"Планы на 2026 год?"},
		{"id":"62404a2f6f14ae27","x":20,"y":4060,"width":250,"height":60,"type":"text","text":"Читать ежедневно книги"},
		{"id":"b5adebc6f5341df2","x":20,"y":4248,"width":335,"height":99,"type":"text","text":"Сделать движок до какого-то состояния, чтобы можно было уже на нем что-то разработать"}
	],
